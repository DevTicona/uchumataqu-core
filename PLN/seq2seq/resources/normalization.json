{
  "version": 1,
  "unicode": "NFC",
  "case": "Python Unicode lower",
  "apostrophes": {"’": "'", "ʼ": "'"},
  "strip_outer_whitespace": true,
  "preserve_diacritics": true,
  "max_input_characters": 32,
  "unsupported_characters": "abstain",
  "overlength": "reject_without_truncation",
  "single_word_only": true,
  "unity_parity_verified": false
}
